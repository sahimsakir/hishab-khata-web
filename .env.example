# Leave blank to use Vite's /api proxy locally. No secrets belong here.
VITE_API_BASE_URL=
# Google starts on Laravel directly so the callback matches the Google Console.
VITE_GOOGLE_AUTH_URL=http://localhost:8000/api/auth/google/redirect
VITE_GOOGLE_LINK_URL=http://localhost:8000/api/auth/google/link
